#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN  10
#define RST_PIN 9

MFRC522 mfrc522(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(9600);
  while (!Serial);

  SPI.begin();
  mfrc522.PCD_Init();
  delay(4);

  Serial.println(F("================================================"));
  Serial.println(F("   MFRC522 DEFAULT CARD READER INITIALIZED"));
  Serial.println(F("================================================"));
  mfrc522.PCD_DumpVersionToSerial();
  Serial.println(F("Tap an RFID card or keyfob to read its UID..."));
  Serial.println();
}

void loop() {
  if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  Serial.println(F("------------------------------------------------"));
  
  // Print HEX UID
  Serial.print(F("UID (HEX)  : "));
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    if (mfrc522.uid.uidByte[i] < 0x10) Serial.print(F("0"));
    Serial.print(mfrc522.uid.uidByte[i], HEX);
    if (i < mfrc522.uid.size - 1) Serial.print(F(" "));
  }
  Serial.println();

  // Print DEC UID
  Serial.print(F("UID (DEC)  : "));
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i], DEC);
    if (i < mfrc522.uid.size - 1) Serial.print(F(" "));
  }
  Serial.println();

  // Print SAK & Card Type
  Serial.print(F("SAK        : 0x"));
  if (mfrc522.uid.sak < 0x10) Serial.print(F("0"));
  Serial.println(mfrc522.uid.sak, HEX);

  MFRC522::PICC_Type piccType = mfrc522.PICC_GetType(mfrc522.uid.sak);
  Serial.print(F("Card Type  : "));
  Serial.println(mfrc522.PICC_GetTypeName(piccType));
  Serial.println(F("------------------------------------------------"));

  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
  delay(1000);
}